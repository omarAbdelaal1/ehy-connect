# ==============================================================================
# EHY Connect — Environment Configuration Template
# Standard: Next.js 14 App Router + Supabase + Meta APIs
# ==============================================================================

# Application Base
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# Supabase Persistence & Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# WhatsApp Business Cloud API (Official Sandbox / Production)
WHATSAPP_PHONE_NUMBER_ID="your_waba_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_waba_account_id"
WHATSAPP_ACCESS_TOKEN="EAA..."
WHATSAPP_APP_SECRET="your_meta_app_secret_here"
WHATSAPP_VERIFY_TOKEN="ehy_connect_verify_token_2026"

# Meta Graph API (Instagram & Facebook Pages)
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"

# Zernio Unified Social Engine (16+ Platforms: TikTok, YouTube, IG, FB)
# Note: If left blank, EHY Connect runs in resilient offline sandbox mode!
ZERNIO_API_KEY=""
ZERNIO_BASE_URL="https://api.zernio.com/v1"

# Concurrency & Collision Lock Settings
COLLISION_LOCK_TIMEOUT_SECONDS="120"
